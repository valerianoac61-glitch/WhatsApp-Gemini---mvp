PORT=3000
NODE_ENV=development

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao_do_webhook_aqui
WHATSAPP_ACCESS_TOKEN=EAAB...seu_access_token_temporario_ou_permanente_aqui
WHATSAPP_APP_SECRET=seu_app_secret_do_meta_app_dashboard_aqui
PHONE_NUMBER_ID=seu_phone_number_id_aqui
WHATSAPP_API_VERSION=v23.0

# Google Gemini API
GEMINI_API_KEY=AIzaSy...sua_gemini_api_key_aqui
# Opcional - padrao: gemini-3.1-flash-lite (estavel, com desligamento
# agendado pela Google para 07/mai/2027 - runway confortavel para este MVP).
# Alternativa mais nova: gemini-3.5-flash-lite (GA, sem data de desligamento
# anunciada ainda, indicada pela Google para automacao de alto volume). Antes
# de migrar, note que 3.5/3.6 ignoram os parametros temperature/top_p/top_k
# (e vao dar erro neles em versoes futuras) - ajuste src/services/geminiService.js
# removendo esse parametro se for trocar. Verifique sempre
# https://ai.google.dev/gemini-api/docs/deprecations antes de decidir.
GEMINI_MODEL=gemini-3.1-flash-lite

# Google Sheets API (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-sa@seuprojeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=1_sua_id_da_planilha_do_google_sheets_aqui
